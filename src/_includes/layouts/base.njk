<!DOCTYPE html>
<html lang="{{ jezyk or 'pl' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ tytul }} — {{ site.tytuly[jezyk] or site.tytul }}</title>
<meta name="para" content="{{ para }}">
<meta name="description" content="{{ opis or i18n[jezyk].opis }}">
{%- for inny in collections.all %}{% if inny.data.para == para and inny.data.jezyk and inny.data.jezyk != jezyk %}
<link rel="alternate" hreflang="{{ inny.data.jezyk }}" href="{{ inny.url }}">
{%- endif %}{% endfor %}
{%- if para %}<link rel="alternate" hreflang="{{ jezyk }}" href="{{ page.url }}">{% endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/ikony/favicon-32.png" sizes="32x32" type="image/png">
<link rel="shortcut icon" href="/assets/ikony/favicon.ico" sizes="32x32">
<link rel="apple-touch-icon" href="/assets/ikony/apple-touch-icon.png">
<!-- Zanim cokolwiek się narysuje: arkusz ma od pierwszej klatki wiedzieć, że
     skrypt działa. Osobny plik, nie wiersz w dokumencie — polityka
     bezpieczeństwa treści („script-src 'self'") blokuje skrypty wpisane
     wprost w stronę, więc taki wiersz działał u nas, a na serwerze nie. -->
<script src="/assets/js/wczesnie.js"></script>
<!-- Kroje pobierane z góry, zanim przeglądarka dojdzie do arkusza: razem
     z „font-display:optional" znaczy to, że strona rysuje się od razu
     właściwym pismem albo — przy bardzo wolnym łączu i pustej pamięci
     podręcznej — zapasowym, ale nigdy jednym po drugim. Podmiana kroju
     w locie przesuwała każdy wiersz o punkt i to właśnie migało. -->
{%- for klucz, plik in kroje %}
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ plik }}">
{%- endfor %}
<link rel="stylesheet" href="/assets/css/fonty.css?v={{ "/assets/css/fonty.css" | odcisk }}">
<link rel="stylesheet" href="/assets/css/site.css?v={{ "/assets/css/site.css" | odcisk }}">
</head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>
<div class="wrap">
{% if not goly %}
<header class="szyld">
  <a class="marka" href="/{{ jezyk }}/">{{ site.tytuly[jezyk] or site.tytul }}</a>
  <nav class="jez" aria-label="Język">
    {%- for j in site.jezyki %}{% if j.kod != jezyk %}<a class="przelacz-jezyk" href="{{ j.prefix }}/" lang="{{ j.kod }}" hreflang="{{ j.kod }}">{{ j.nazwa }}</a>{% endif %}{% endfor %}
  </nav>
</header>
{% include "partials/bench.njk" %}
{% endif %}
<p class="wersja-status">{{ i18n[jezyk].status }} <a href="{{ i18n[jezyk].agendaUrl }}">{{ i18n[jezyk].statusLink }}</a>.</p>
<main id="tresc">
{{ content | safe }}
</main>
{% if not goly %}
<footer>
  <p>{{ i18n[jezyk].stopka | safe }}</p>
  <p><a href="{{ i18n[jezyk].agendaUrl }}">{{ i18n[jezyk].zrodlaLink }}</a>
  {%- if jezyk == "pl" %} · <a href="/pl/zrodla/">źródła</a> · <a href="/pl/decyzje/">rejestr decyzji</a> · <a href="/pl/zmiany/">rejestr zmian</a>{% endif %}</p>
</footer>
{% endif %}
</div>
<script type="module" src="/assets/js/bootstrap.js?v={{ "/assets/js/bootstrap.js" | odcisk }}"></script>
</body>
</html>
