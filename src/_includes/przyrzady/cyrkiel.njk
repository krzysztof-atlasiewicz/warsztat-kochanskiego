{% set s = i18n[jezyk] %}
<div class="stage">
<svg class="duza" viewBox="45 134 595 378" preserveAspectRatio="xMidYMid meet" role="img" aria-describedby="o-cyrkiel">
<desc id="o-cyrkiel">{{ s.cyrkiel.opis }}</desc>
<circle id="k1" cx="200" cy="300" r="140" fill="none" stroke="var(--ink)" stroke-width="1.6"/>
<line id="k1b" x1="200" y1="160" x2="200" y2="440" stroke="var(--rule)" stroke-width="1.4" stroke-dasharray="5 5"/>
<circle cx="200" cy="300" r="4" fill="var(--ink-soft)"/>
<circle id="ptB" cx="200" cy="160" r="5" fill="var(--ink)"/>
<circle id="ptA" cx="200" cy="440" r="5" fill="var(--ink)"/>
<text class="t" x="172" y="152">B</text><text class="t" x="172" y="468">A</text><text class="t" x="216" y="292">O</text>
<line id="k2" x1="95" y1="440" x2="620" y2="440" stroke="var(--ink)" stroke-width="1.4" opacity="0"/>
<line id="k3" x1="200" y1="300" x2="119.2" y2="440" stroke="var(--verd)" stroke-width="1.8" opacity="0"/>
<path id="k3a" d="M 200 370 A 70 70 0 0 1 165 360" fill="none" stroke="var(--verd)" stroke-width="1.4" opacity="0"/>
<text id="k3l" class="t" x="208" y="396" opacity="0">30°</text>
<circle id="ptC" cx="119.2" cy="440" r="5" fill="var(--verd)" opacity="0"/>
<text id="lC" class="t" x="100" y="468" opacity="0">C</text>
<line id="k4" x1="119.2" y1="440" x2="539.2" y2="440" stroke="var(--verd)" stroke-width="3.2" opacity="0"/>
<line id="k4a" x1="259.2" y1="428" x2="259.2" y2="452" stroke="var(--verd)" stroke-width="1.4" opacity="0"/>
<line id="k4b" x1="399.2" y1="428" x2="399.2" y2="452" stroke="var(--verd)" stroke-width="1.4" opacity="0"/>
<circle id="ptD" cx="539.2" cy="440" r="5" fill="var(--verd)" opacity="0"/>
<text id="lD" class="t" x="528" y="468" opacity="0">D</text>
<text id="l3r" class="t" x="310" y="494" opacity="0">3r</text>
<line id="k5" x1="200" y1="160" x2="539.2" y2="440" stroke="var(--sun)" stroke-width="3.2" opacity="0"/>
<text id="l5" class="tb" x="392" y="256" opacity="0" fill="var(--sun)">BD ≈ πr</text>
</svg>
</div>

<p class="kroki-sterowanie"><button id="cofnij">{{ s.cyrkiel.cofnij }}</button> <button id="dalej">{{ s.cyrkiel.dalej }}</button></p>
<p id="opis" data-kroki='{{ s.cyrkiel.krok | dump }}' aria-live="polite">{{ s.cyrkiel.krok[0] | safe }}</p>

<div id="panel" class="hide">
<div class="ctl"><label for="promien">{{ s.cyrkiel.promien }}</label><input type="range" id="promien" min="10" max="2000" step="10" value="150"><output id="promienO">150 mm</output></div>
<dl class="read" aria-live="polite">
<div><dt>{{ s.cyrkiel.konstrukcja }}</dt><dd id="w1">—</dd></div>
<div><dt>{{ s.cyrkiel.prawdziwe }}</dt><dd id="w2">—</dd></div>
<div><dt>{{ s.cyrkiel.blad }}</dt><dd id="w3">—</dd></div>
</dl>
</div>
