{% set s = i18n[jezyk] %}

<div class="przyrzady-gnomon" data-napisy='{{ s.gnomon.napisy | dump }}'>

<section class="plansza pulpit">
  <h3 class="plansza-tytul">{{ s.gnomon.pulpitTytul }}</h3>
  <p class="plansza-opis">{{ s.gnomon.pulpitOpis }}</p>
  <div class="pulpit-sterowniki">

    <figure class="blok-daty">
      <svg viewBox="0 0 160 190" class="kartka" role="img" aria-describedby="o-kartka">
        <desc id="o-kartka">{{ s.gnomon.opisKartki }}</desc>
        <path d="M 10 18 L 150 18 L 150 160 Q 120 170 90 162 Q 55 153 10 164 Z"
              fill="var(--plyta-jasna)" stroke="var(--rule)" stroke-width="1"/>
        <line x1="10" y1="42" x2="150" y2="42" stroke="var(--mosiadz-ciemny)" stroke-width="1.2"/>
        <circle cx="42" cy="18" r="4" fill="none" stroke="var(--rule)" stroke-width="1"/>
        <circle cx="118" cy="18" r="4" fill="none" stroke="var(--rule)" stroke-width="1"/>
        <text id="kalMiesiac" class="t" x="80" y="36" text-anchor="middle">—</text>
        <text id="kalDzien" class="kartka-liczba" x="80" y="112" text-anchor="middle">—</text>
        <text id="kalPora" class="t" x="80" y="140" text-anchor="middle">—</text>
        <text id="kalDzien2" class="t" x="80" y="156" text-anchor="middle">—</text>
      </svg>
      <figcaption class="pola-daty">
        <span class="wybor"><label for="dzien">{{ s.gnomon.dzien }}</label>
          <select id="dzien" title="{{ s.gnomon.opisy.dzien }}"></select></span>
        <span class="wybor"><label for="miesiac">{{ s.gnomon.miesiac }}</label>
          <select id="miesiac" title="{{ s.gnomon.opisy.miesiac }}"></select></span>
      </figcaption>
    </figure>

    <figure class="blok-zegara">
      <svg viewBox="0 0 200 224" class="tarcza-mechaniczna" role="img" aria-describedby="o-tarcza">
        <desc id="o-tarcza">{{ s.gnomon.opisTarczy }}</desc>
        <defs>
          <radialGradient id="mosiadzZ" cx="35%" cy="30%">
            <stop offset="0" stop-color="var(--mosiadz-jasny)"/><stop offset="1" stop-color="var(--mosiadz-ciemny)"/>
          </radialGradient>
        </defs>

        <g id="koronka" role="slider" tabindex="0" class="koronka"
           aria-label="{{ s.gnomon.zegar }}" aria-valuemin="4" aria-valuemax="21" aria-valuenow="12">
          <circle cx="100" cy="9" r="7" fill="none" stroke="var(--mosiadz-ciemny)" stroke-width="3"/>
          <rect x="93" y="15" width="14" height="13" rx="2" fill="url(#mosiadzZ)" stroke="var(--mosiadz-ciemny)" stroke-width="1"/>
          <circle cx="100" cy="34" r="13" fill="url(#mosiadzZ)" stroke="var(--mosiadz-ciemny)" stroke-width="1.2"/>
          <g id="radelko"></g>
          <circle cx="100" cy="34" r="4" fill="none" stroke="var(--mosiadz-ciemny)" stroke-width="1"/>
        </g>

        <g id="tarczaZegara" class="tarcza-chwyt">
          <circle cx="100" cy="128" r="88" fill="url(#mosiadzZ)" stroke="var(--mosiadz-ciemny)" stroke-width="1"/>
          <circle cx="100" cy="128" r="80" fill="var(--plyta-jasna)" stroke="var(--mosiadz-ciemny)" stroke-width="1.4"/>
          <circle cx="100" cy="128" r="52" fill="none" stroke="var(--rule-soft)" stroke-width="0.7"/>
          <g id="pierscienGodzin"></g>
          <path id="lukRoznicy" fill="none"/>
          <g id="wskazowkiSlon">
            <line id="wskMinutSlon" x1="100" y1="128" x2="100" y2="60" class="wsk-slon"/>
            <path id="wskGodzinSlon" d="M 100 128 L 96 96 L 100 82 L 104 96 Z" class="wsk-slon-godz"/>
          </g>
          <g id="wskazowki">
            <line id="wskMinut" x1="100" y1="128" x2="100" y2="58" class="wsk-mech"/>
            <path id="wskGodzin" d="M 100 128 L 95.5 94 L 100 78 L 104.5 94 Z" class="wsk-mech-godz"/>
          </g>
          <circle cx="100" cy="128" r="6" fill="url(#mosiadzZ)" stroke="var(--mosiadz-ciemny)" stroke-width="1"/>
          <circle cx="100" cy="128" r="2" fill="var(--ink)"/>
          <g id="okienkoRoznicy">
            <rect x="74" y="158" width="52" height="17" rx="3" class="plytka-roznicy"/>
            <text id="napisRoznicy" class="napis-roznicy" x="100" y="170" text-anchor="middle"></text>
          </g>
        </g>
      </svg>
      <figcaption class="odczyt-zegara">
        <span class="para-zegara"><b class="znak-mech"></b><span id="mech">—</span> {{ s.gnomon.mech }}</span>
        <span class="para-zegara"><b class="znak-slon"></b><span id="slon">—</span> {{ s.gnomon.slon }}</span>
        <span class="para-zegara"><b class="znak-luk"></b><span id="roznica">—</span> {{ s.gnomon.roznica }}</span>
      </figcaption>
    </figure>

    <div class="blok-objasnien">
      <p>{{ s.gnomon.jakNastawic }}</p>
      <p>{{ s.gnomon.scianaOpis }}</p>
      <p>{{ s.gnomon.kiedyUwaga }}</p>
    </div>
  </div>

  <div class="przewijalna">
  <svg viewBox="0 0 820 390" class="wide sciana" role="img" aria-describedby="o-sciana">
    <desc id="o-sciana">{{ s.gnomon.opis }}</desc>
    <rect x="0" y="0" width="820" height="390" fill="var(--niebo)"/>
    <rect x="110" y="78" width="600" height="312" fill="var(--tynk)" stroke="var(--rule)" stroke-width="1"/>
    <g class="ciosy">
      <line x1="110" y1="136" x2="710" y2="136"/><line x1="110" y1="196" x2="710" y2="196"/>
      <line x1="110" y1="256" x2="710" y2="256"/><line x1="110" y1="316" x2="710" y2="316"/>
    </g>
    <rect x="104" y="72" width="612" height="16" class="gzyms"/>
    <rect x="122" y="92" width="576" height="278" fill="none" stroke="var(--rule-soft)" stroke-width="0.8"/>
    <g id="tarcze" aria-live="polite"></g>
    <g id="promienie"></g>
    <g id="cienie"></g>
    <g id="slonce"></g>
    <text id="brakSlonca" class="tb" x="410" y="30" text-anchor="middle" opacity="0">{{ s.gnomon.brakSlonca }}</text>
  </svg>
  </div>

  <div class="pulpit-stopka">
    <div>
      <p class="rzad-objasnien">
        <span class="dim małe">{{ s.gnomon.ktoraRachuba }}</span>
        <button type="button" class="guzik-tarczy guzik-wloskie" data-tarcza="wloskie"></button>
        <button type="button" class="guzik-tarczy guzik-rowne" data-tarcza="rowne"></button>
        <button type="button" class="guzik-tarczy guzik-babilonskie" data-tarcza="babilonskie"></button>
      </p>
      <p id="dymekTarczy" class="dymek" aria-live="polite"></p>
    </div>
    <div>
      <p class="rzad-przelacznika">
        <button id="przelacz" class="przelacznik" role="switch" aria-checked="false"
                aria-describedby="coToAnalemma" title="{{ s.gnomon.opisy.analemma }}">
          <span class="przelacznik-tor" aria-hidden="true"><span class="przelacznik-dzwignia"></span></span>
          <span class="przelacznik-napis">{{ s.gnomon.analemma }}</span>
        </button>
      </p>
      <p id="coToAnalemma" class="dymek">{{ s.gnomon.coToAnalemma }}</p>
    </div>
  </div>

  <p class="dim małe">{{ s.gnomon.scianaLegenda }}</p>
  <p class="note">{{ s.gnomon.poCoTrzy }}</p>
</section>

</div>
