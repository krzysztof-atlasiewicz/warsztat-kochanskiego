{% set s = i18n[jezyk] %}
<div class="stage" data-miesiace='{{ s.gnomon.miesiace | dump }}'>
<svg viewBox="0 0 380 250" role="img" aria-describedby="o-gnomon">
<desc id="o-gnomon">{{ s.gnomon.opis }}</desc>
<rect x="24" y="16" width="332" height="218" fill="none" stroke="var(--rule)" stroke-width="1"/>
<polyline id="przesilenieL" fill="none" stroke="var(--sun)" stroke-width="1" stroke-dasharray="4 3"/>
<polyline id="rownonoc" fill="none" stroke="var(--rule)" stroke-width="1"/>
<polyline id="przesilenieZ" fill="none" stroke="var(--verd)" stroke-width="1" stroke-dasharray="4 3"/>
<polyline id="analemma" fill="none" stroke="var(--verd)" stroke-width="1.6"/>
<line id="promien2" x1="190" y1="60" x2="190" y2="60" stroke="var(--ink-soft)" stroke-width="1" stroke-dasharray="2 3"/>
<circle id="grot" cx="190" cy="60" r="4" fill="var(--sun)"/>
<circle cx="190" cy="60" r="3" fill="var(--ink)"/>
<text id="brakSlonca" class="t" x="190" y="132" text-anchor="middle" opacity="0">{{ s.gnomon.brakSlonca }}</text>
</svg>
</div>

<div class="ctl"><label for="data">{{ s.gnomon.data }}</label><input type="range" id="data" min="1" max="365" step="1" value="172"><output id="dataO">21 cze</output></div>
<div class="ctl"><label for="zegar">{{ s.gnomon.zegar }}</label><input type="range" id="zegar" min="4" max="21" step="0.25" value="12"><output id="zegarO">12:00</output></div>

<dl class="read" aria-live="polite">
<div><dt>{{ s.gnomon.rowne }}</dt><dd id="rowne">—</dd></div>
<div><dt>{{ s.gnomon.wloskie }}</dt><dd id="wloskie">—</dd></div>
<div><dt>{{ s.gnomon.babilonskie }}</dt><dd id="babilonskie">—</dd></div>
</dl>
<dl class="read" aria-live="polite">
<div><dt>{{ s.gnomon.mech }}</dt><dd id="mech">—</dd></div>
<div><dt>{{ s.gnomon.slon }}</dt><dd id="slon">—</dd></div>
<div><dt>{{ s.gnomon.roznica }}</dt><dd id="roznica">—</dd></div>
</dl>
<p><button id="przelacz" data-pokaz="{{ s.gnomon.analemmaPokaz }}" data-ukryj="{{ s.gnomon.analemmaUkryj }}">{{ s.gnomon.analemmaPokaz }}</button></p>
