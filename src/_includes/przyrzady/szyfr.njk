{% set s = i18n[jezyk] %}
<div class="stage szyfr-nastawa">
<div class="szyfr-tarcza">
<svg id="tarcza" class="tarcza-zegarmistrzowska" viewBox="0 0 320 320"
     role="slider" tabindex="0" aria-valuemin="0" aria-valuemax="25" aria-valuenow="0"
     aria-label="{{ s.szyfr.obrot }}" aria-describedby="o-szyfr">
<desc id="o-szyfr">{{ s.szyfr.opis }}</desc>
<defs>
  <radialGradient id="mosiadz" cx="34%" cy="28%" r="78%">
    <stop offset="0" stop-color="var(--mosiadz-jasny)"/>
    <stop offset="1" stop-color="var(--mosiadz-ciemny)"/>
  </radialGradient>
  <radialGradient id="plyta" cx="38%" cy="30%" r="85%">
    <stop offset="0" stop-color="var(--plyta-jasna)"/>
    <stop offset="1" stop-color="var(--plyta-ciemna)"/>
  </radialGradient>
</defs>

<rect x="6" y="6" width="308" height="308" rx="12" fill="url(#plyta)" stroke="var(--rule)" stroke-width="1"/>
<rect x="13" y="13" width="294" height="294" rx="8" fill="none" stroke="var(--rule-soft)" stroke-width="0.6"/>
<g fill="var(--rule)" opacity="0.9">
  <circle cx="24" cy="24" r="4.2"/><circle cx="296" cy="24" r="4.2"/>
  <circle cx="24" cy="296" r="4.2"/><circle cx="296" cy="296" r="4.2"/>
</g>
<g stroke="var(--plyta-ciemna)" stroke-width="1.1">
  <line x1="21" y1="21" x2="27" y2="27"/><line x1="293" y1="27" x2="299" y2="21"/>
  <line x1="21" y1="299" x2="27" y2="293"/><line x1="293" y1="293" x2="299" y2="299"/>
</g>

<g id="radelko"></g>
<circle cx="160" cy="160" r="143" fill="none" stroke="var(--mosiadz-ciemny)" stroke-width="1"/>
<circle cx="160" cy="160" r="139" fill="none" stroke="var(--rule-soft)" stroke-width="0.6"/>
<circle id="pierscien" cx="160" cy="160" r="107" fill="none" stroke="var(--rule)" stroke-width="0.8"/>
<g id="zabki"></g>

<circle cx="160" cy="160" r="72" fill="url(#mosiadz)" opacity="0.14" stroke="var(--mosiadz-ciemny)" stroke-width="0.8"/>
<circle cx="160" cy="160" r="66" fill="none" stroke="var(--mosiadz-ciemny)" stroke-width="0.4" opacity="0.5"/>
<circle cx="160" cy="160" r="61" fill="none" stroke="var(--mosiadz-ciemny)" stroke-width="0.4" opacity="0.35"/>
<circle cx="160" cy="160" r="56" fill="none" stroke="var(--mosiadz-ciemny)" stroke-width="0.4" opacity="0.2"/>

<g id="litery"></g>
<g id="wskaznikWew"></g>

<circle cx="160" cy="160" r="30" fill="url(#mosiadz)" stroke="var(--mosiadz-ciemny)" stroke-width="1"/>
<circle cx="160" cy="160" r="25" fill="none" stroke="var(--plyta-jasna)" stroke-width="0.6" opacity="0.6"/>
<text id="srodek" class="srodek-liczba" x="160" y="160" text-anchor="middle" dominant-baseline="central">0</text>

<polygon points="152,10 168,10 160,26" fill="var(--mosiadz-ciemny)"/>
<line x1="160" y1="26" x2="160" y2="34" stroke="var(--mosiadz-ciemny)" stroke-width="1.4"/>
</svg>
</div>
<p class="dim małe tarcza-podpowiedz">{{ s.szyfr.sterowanie }}</p>
</div>

<div class="odwzorowanie">
  <p class="dim małe">{{ s.szyfr.paskiOpis }}</p>
  <div id="pasek" class="pasek" role="group" aria-label="{{ s.szyfr.paskiOpis }}"></div>
  <p id="para" class="para" aria-live="polite"></p>
</div>

<div class="szyfr-pola">
  <p class="pole">
    <label for="jawny">{{ s.szyfr.jawny }}</label>
    <textarea id="jawny" rows="3" spellcheck="false" placeholder="{{ s.szyfr.jawnyPodpowiedz }}"></textarea>
  </p>
  <p class="pole">
    <label for="szyfrogram">{{ s.szyfr.zapis }}</label>
    <textarea id="szyfrogram" rows="3" spellcheck="false" class="ciph"></textarea>
  </p>
</div>

<div class="row szyfr-dzialania" data-napisy='{{ s.szyfr.napisy | dump }}'>
  <label class="wybor"><span>{{ s.szyfr.jezykAnalizy }}</span>
    <select id="jezykAnalizy">
      <option value="pl">{{ s.szyfr.polski }}</option>
      <option value="en">{{ s.szyfr.angielski }}</option>
      <option value="la" selected>{{ s.szyfr.lacina }}</option>
    </select>
  </label>
  <button id="lam" title="{{ s.szyfr.opisy.lam }}">{{ s.szyfr.lam }}</button>
  <button id="kopiuj" title="{{ s.szyfr.opisy.kopiuj }}">{{ s.szyfr.kopiuj }}</button>
  <button id="odnosnik" title="{{ s.szyfr.opisy.odnosnik }}">{{ s.szyfr.odnosnik }}</button>
  <button id="historyczny" title="{{ s.szyfr.opisy.historyczny }}">{{ s.szyfr.historyczny }}</button>
</div>
<p id="komunikat" class="dim" aria-live="polite"></p>

<details class="wyprowadzenie" id="kroki">
  <summary>{{ s.szyfr.krokiTytul }}</summary>
  <ol id="krokiLista"></ol>
</details>

<div id="rozwiazane" class="hide">
<p class="note">{{ s.szyfr.rozwiazane }}</p>
</div>
