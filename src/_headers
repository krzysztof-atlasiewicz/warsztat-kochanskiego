/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; frame-src https://archive.org; frame-ancestors *

# Reguły nie mogą na siebie zachodzić: przy kilku pasujących wzorcach Cloudflare
# skleja nagłówki zamiast nadpisywać, więc plik dostaje dwie sprzeczne dyrektywy.

# Pobierane z odciskiem treści w adresie (?v=) — mogą leżeć dowolnie długo.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Kod jest importowany przez inny kod, więc modułom nie da się nadać odcisku.
# Sprawdzany przy każdym wejściu — inaczej nowa strona trafia na stary moduł
# i przyrząd nie uruchamia się wcale, bez żadnego komunikatu.
/assets/js/*
  Cache-Control: public, no-cache
