/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; frame-src https://archive.org; frame-ancestors *

# Pliki z odciskiem treści w adresie (?v=) mogą leżeć w pamięci podręcznej dowolnie długo.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Moduły ładowane leniwie nie mają odcisku w adresie, więc muszą być sprawdzane
# przy każdym wejściu. Inaczej nowa strona trafia na stary moduł i przyrząd
# przestaje się uruchamiać, bez żadnego komunikatu.
/assets/js/*
  Cache-Control: public, no-cache

/assets/js/bootstrap.js
  Cache-Control: public, max-age=31536000, immutable
